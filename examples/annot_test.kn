# annot_test.kn -- @test and @test(isolate: true) annotations

# ---- Functions under test ----------------------------------------------------

def add(a: int, b: int) -> int {
    return a + b
}

def multiply(a: int, b: int) -> int {
    return a * b
}

def factorial(n: int) -> int {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

def is_palindrome(s: str) -> bool {
    n: int = s.length()
    mut i: int = 0
    while i < n / 2 {
        if !(s[i] == s[n - 1 - i]) {
            return false
        }
        i = i + 1
    }
    return true
}

def clamp(x: int, lo: int, hi: int) -> int {
    if x < lo { return lo }
    if x > hi { return hi }
    return x
}

# ---- @test functions ---------------------------------------------------------

@test
def test_add_zero() -> void {
    result: int = add(0, 0)
    assert(result == 0)
}

@test
def test_add_positive() -> void {
    assert(add(2, 3) == 5)
    assert(add(10, 20) == 30)
}

@test
def test_add_negative() -> void {
    assert(add(-1, 1) == 0)
    assert(add(-5, -3) == -8)
}

@test
def test_multiply_zero() -> void {
    assert(multiply(0, 100) == 0)
    assert(multiply(100, 0) == 0)
}

@test
def test_multiply_identity() -> void {
    assert(multiply(1, 42) == 42)
    assert(multiply(42, 1) == 42)
}

@test
def test_factorial_base() -> void {
    assert(factorial(0) == 1)
    assert(factorial(1) == 1)
}

@test
def test_factorial_small() -> void {
    assert(factorial(5) == 120)
    assert(factorial(6) == 720)
}

@test
def test_clamp_below() -> void {
    assert(clamp(-5, 0, 10) == 0)
}

@test
def test_clamp_above() -> void {
    assert(clamp(15, 0, 10) == 10)
}

@test
def test_clamp_within() -> void {
    assert(clamp(5, 0, 10) == 5)
}

# ---- @test(isolate: true) for isolated tests ---------------------------------

@test { isolate: true }
def test_isolated_factorial() -> void {
    assert(factorial(10) == 3628800)
}

@test { isolate: true }
def test_isolated_expensive() -> void {
    mut total: int = 0
    mut i: int = 0
    while i < 100000 {
        total = total + factorial(i - i + 1)
        i = i + 1
    }
    assert(total > 0)
}

@test { isolate: true }
def test_palindrome() -> void {
    assert(is_palindrome("racecar"))
    assert(is_palindrome("level"))
    assert(!is_palindrome("hello"))
}

# ---- @test { ignore } for skipped tests -------------------------------------

@test { ignore: true }
def test_skipped_placeholder() -> void {
    assert(false)
}

@test { ignore: "not yet implemented" }
def test_skipped_with_reason() -> void {
    assert(false)
}

# ---- assert_eq, assert_ne, assert_raises ------------------------------------

@test
def test_assert_eq() -> void {
    assert_eq(add(2, 3), 5)
    assert_eq(multiply(3, 4), 12)
    assert_ne(add(1, 1), 3)
}

@test
def test_assert_raises() -> void {
    assert_raises(ValueError, () -> {
        checked_div(10, 0)
    })
}

def checked_div(a: int, b: int) -> int {
    if b == 0 {
        raise ValueError { message: "division by zero" }
    }
    return a / b
}

struct ValueError: Exception {
    message: str
}

# ---- Bare raise (re-raise) ---------------------------------------------------

def reraise_example(a: int, b: int) -> int {
    try {
        return checked_div(a, b)
    } except ValueError as e {
        print("logging: {e.message}")
        raise
    }
    return 0
}

def main() -> void {
    test_add_zero()
    test_add_positive()
    test_add_negative()
    test_multiply_zero()
    test_multiply_identity()
}
