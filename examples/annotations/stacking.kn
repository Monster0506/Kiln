# stacking.kn -- multiple processors applied in bottom-up order, composing
#
# Kiln uses Python decorator convention: the annotation closest to the function
# is the innermost transform (applied first); the topmost annotation is the
# outermost wrapper (applied last).
#
# Each processor in a stack receives the OUTPUT of the previous one as its
# `target`.  This is guaranteed: run_user_processors chains transformations
# rather than applying each independently.
#
# Demonstrates:
#   - @Retry (bottom/inner) wraps the body in a retry loop first
#   - @LogEnter (top/outer) prepends a log statement to whatever Retry produced
#   - Final body: [log_stmt, retry_loop_wrapping_original_body]
#
# Usage: kiln run examples/annotations/stacking.kn

# ---- Retry ------------------------------------------------------------------

annotation Retry {
    count: int = 3
}

processor Retry(target: FnDecl) -> (Option[Decl], Vec[Decl]) {
    new_body: Block = gen {
        mut attempts: int = 0
        while attempts < <<target.annot.count>> {
            try {
                <<target.body>>
                break
            } except Exception as e {
                attempts = attempts + 1
                if attempts == <<target.annot.count>> {
                    raise e
                }
            }
        }
    }
    return (Some { value: target.with_body(new_body) }, Vec.new())
}

# ---- LogEnter ---------------------------------------------------------------

annotation LogEnter {
    label: str = "info"
}

processor LogEnter(target: FnDecl) -> (Option[Decl], Vec[Decl]) {
    tag: str = "{target.annot.label}: entering {target.name}"
    new_body: Block = gen {
        entered: str = <<tag>>
        println(entered)
        <<target.body>>
    }
    return (Some { value: target.with_body(new_body) }, Vec.new())
}

# ---- Functions using both annotations ---------------------------------------
#
# @LogEnter is on top (outer) -> runs SECOND, sees the retry-wrapped body
# @Retry { count: 2 } is below (inner) -> runs FIRST, wraps body in retry loop
#
# The generated body is equivalent to:
#
#   def upload(payload: str) -> void {
#       entered: str = "debug: entering upload"
#       println(entered)
#       mut attempts: int = 0
#       while attempts < 2 {
#           try {
#               println("uploading")
#               break
#           } except Exception as e {
#               attempts = attempts + 1
#               if attempts == 2 { raise e }
#           }
#       }
#   }

@LogEnter { label: "debug" }
@Retry { count: 2 }
def upload(payload: str) -> void {
    println("uploading")
}

def main() -> void {
    upload("data")
}
