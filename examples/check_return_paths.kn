# check_return_paths.kn -- tricky return path analysis

# OK: every branch of a multi-elif chain has a return AND there's an else
def classify(n: int) -> str {
    if n < 0 {
        return "negative"
    } elif n == 0 {
        return "zero"
    } else {
        return "positive"
    }
}

# ERROR: elif chain but no else -- falls off the end when n >= 0
def classify_incomplete(n: int) -> str {
    if n < 0 {
        return "negative"
    } elif n == 0 {
        return "zero"
    }
    # no else -- n > 0 path falls off
}

# OK: try/catch where body and all handlers return
def safe_parse(s: str) -> int {
    try {
        return 0
    } except Exception as e {
        return -1
    }
}

# ERROR: try body returns but handler does not
def bad_parse(s: str) -> int {
    try {
        return 0
    } except Exception as e {
        n: int = 1
        # forgot to return!
    }
}

# OK: nested if inside try, all paths covered
def nested_ok(x: int) -> int {
    try {
        if x > 0 {
            return x
        } else {
            return 0
        }
    } except Exception as e {
        return -1
    }
}

# ERROR: while loop body always returns but while itself doesn't guarantee execution
def loop_not_enough(items: Vec[int]) -> int {
    while 1 == 1 {
        return 0
    }
    # analyzer conservatively says while never guarantees return
}

# OK: void functions never need a return statement
def setup(x: int) -> void {
    y: int = x + 1
}

def main() -> void {
}
