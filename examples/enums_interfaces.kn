# enums_interfaces.kn -- enums implementing interfaces, @derive on enums

# ---- @derive on enums --------------------------------------------------------

@derive(Eq)
enum Color {
    Red
    Green
    Blue
}

@derive(Eq, Display)
enum Weekday {
    Monday
    Tuesday
    Wednesday
    Thursday
    Friday
    Saturday
    Sunday
}

# ---- Enum implementing Comparable --------------------------------------------

@derive(Comparable)
enum Priority {
    Low
    Medium
    High
    Critical
}

# ---- Enum implementing Display -----------------------------------------------

enum Status: Display {
    Pending
    Running
    Done
    Failed
}

impl Display for Status {
    hook to_str() -> str {
        return match self {
            Pending => "pending",
            Running => "running",
            Done => "done",
            Failed => "FAILED"
        }
    }
}

# ---- Enum implementing Eq ----------------------------------------------------

enum Direction: PartialEq {
    North
    South
    East
    West
}

impl PartialEq for Direction {
    hook ==(other: Direction) -> bool {
        return match self {
            North => match other { North => true, _ => false },
            South => match other { South => true, _ => false },
            East => match other { East => true, _ => false },
            West => match other { West => true, _ => false }
        }
    }
}

impl Eq for Direction {}

# ---- Generic enum with interface conformance --------------------------------

enum Result[T, E]: Display {
    Ok { value: T }
    Err { error: E }
}

impl Display for Result[int, str] {
    hook to_str() -> str {
        return match self {
            Ok { value: _ } => "Ok(...)",
            Err { error: _ } => "Err(...)"
        }
    }
}

# ---- Using interface methods on enums ----------------------------------------

def sort_priorities(items: Vec[Priority]) -> Vec[Priority] {
    # bubble sort for illustration
    n: int = items.length()
    mut i: int = 0
    while i < n {
        mut j: int = 0
        while j < n - i - 1 {
            a: Priority = items[j]
            b: Priority = items[j + 1]
            if (a <=> b) == Ordering:Greater {
                items[j] = b
                items[j + 1] = a
            }
            j = j + 1
        }
        i = i + 1
    }
    return items
}

def main() -> void {
    # @derive(Eq) -- Color
    println(Color:Red == Color:Red)
    println(Color:Red == Color:Blue)

    # @derive(Comparable) -- Priority
    println((Priority:High <=> Priority:Low) == Ordering:Greater)
    println((Priority:Low <=> Priority:Critical) == Ordering:Less)
    println(Priority:Low < Priority:High)
    sorted: Vec[Priority] = sort_priorities([Priority:Critical, Priority:Low, Priority:High, Priority:Medium])
    println(sorted)

    # Manual Display impl -- Status
    println(Status:Pending)
    println(Status:Failed)

    # Manual Eq impl -- Direction
    println(Direction:North == Direction:North)
    println(Direction:North == Direction:South)

}
