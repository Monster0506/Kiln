# hkt.kn -- higher-kinded type interfaces (HKTs)
#
# HKTs allow abstraction over type constructors, not just instantiated types.
# F[_] denotes a type constructor that takes one type argument.

interface Copyable {
}

interface Callable[Args, Ret] {
    hook ()(args: Args) -> Ret
}

# ---- Functor: F[A] -> F[B] via a mapping function --------------------------

interface Functor[F[_]] {
    def map[A, B](value: F[A], f: Callable[(A), B]) -> F[B] {}
}

# ---- Applicative: wrapping values and applying wrapped functions -------------

interface Applicative[F[_]]: Functor[F] {
    def pure[A](value: A) -> F[A] {}
    def apply[A, B](ff: F[Callable[(A), B]], fa: F[A]) -> F[B] {}
}

# ---- Monad: sequential composition ------------------------------------------

interface Monad[F[_]]: Applicative[F] {
    def bind[A, B](fa: F[A], f: Callable[(A), F[B]]) -> F[B] {}
}

# ---- Traversable: traversal with effects ------------------------------------

interface Traversable[F[_]]: Functor[F] {
    def traverse[G[_]: Applicative, A, B](fa: F[A], f: Callable[(A), G[B]]) -> G[F[B]] {}
}

# ---- FoldableF: reduction to a summary value (HKT variant) ------------------

interface FoldableF[F[_]] {
    def fold_left[A, B](fa: F[A], init: B, f: Callable[(B, A), B]) -> B {}
    def fold_right[A, B](fa: F[A], init: B, f: Callable[(A, B), B]) -> B {}
}

# ---- Option as a monad example (declaration only) ---------------------------

def map_option[A, B](opt: Option[A], f: Callable[(A), B]) -> Option[B] {
    if opt == None {
        return None
    }
    return Some(f(opt))
}

def bind_option[A, B](opt: Option[A], f: Callable[(A), Option[B]]) -> Option[B] {
    if opt == None {
        return None
    }
    return f(opt)
}

def main() -> void {
}
