# layer1_arithmetic.kn -- heterogeneous binary arithmetic interfaces (Layer 1 operational core)
#
# Operators are typed relations: A op B -> C
# The associated Output type captures the result type.

interface AddableWith[Rhs] {
    type Output

    hook +(rhs: Rhs) -> Output
}

interface SubtractableWith[Rhs] {
    type Output

    hook -(rhs: Rhs) -> Output
}

interface MultipliableWith[Rhs] {
    type Output

    hook *(rhs: Rhs) -> Output
}

interface DividableWith[Rhs] {
    type Output

    hook /(rhs: Rhs) -> Output
}

interface RemainderableWith[Rhs] {
    type Output

    hook %(rhs: Rhs) -> Output
}

# ---- Example: Vec2 + scalar -> Vec2, Vec2 + Vec2 -> Vec2 --------------------

struct Vec2 {
    x: float
    y: float
}

impl AddableWith[Vec2] for Vec2 {
    hook +(rhs: Vec2) -> Vec2 {
        return Vec2 { x: x + rhs.x, y: y + rhs.y }
    }
}

impl MultipliableWith[float] for Vec2 {
    hook *(rhs: float) -> Vec2 {
        return Vec2 { x: x * rhs, y: y * rhs }
    }
}

# ---- Example: int is AddableWith[int] -> int --------------------------------

struct Meters {
    value: float
}

impl AddableWith[Meters] for Meters {
    hook +(rhs: Meters) -> Meters {
        return Meters { value: value + rhs.value }
    }
}

impl MultipliableWith[float] for Meters {
    hook *(rhs: float) -> Meters {
        return Meters { value: value * rhs }
    }
}

def add_vecs(a: Vec2, b: Vec2) -> Vec2 {
    return a + b
}

def scale(v: Vec2, s: float) -> Vec2 {
    return v * s
}

def main() -> void {
}
