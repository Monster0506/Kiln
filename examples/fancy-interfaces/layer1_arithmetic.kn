# layer1_arithmetic.kn -- heterogeneous binary arithmetic interfaces (Layer 1 operational core)
#
# Operators are typed relations: A op B -> C
# The associated Output type captures the result type.
# AddableWith, SubtractableWith, MultipliableWith, DividableWith, RemainderableWith
# are provided by the prelude.

# ---- Example: Vec2 + scalar -> Vec2, Vec2 + Vec2 -> Vec2 --------------------

struct Vec2 {
    x: float
    y: float
}

impl AddableWith[Vec2] for Vec2 {
    hook +(rhs: Vec2) -> Vec2 {
        return Vec2 { x: self.x + rhs.x, y: self.y + rhs.y }
    }
}

impl MultipliableWith[float] for Vec2 {
    hook *(rhs: float) -> Vec2 {
        return Vec2 { x: self.x * rhs, y: self.y * rhs }
    }
}

# ---- Example: int is AddableWith[int] -> int --------------------------------

struct Meters {
    value: float
}

impl AddableWith[Meters] for Meters {
    hook +(rhs: Meters) -> Meters {
        return Meters { value: self.value + rhs.value }
    }
}

impl MultipliableWith[float] for Meters {
    hook *(rhs: float) -> Meters {
        return Meters { value: self.value * rhs }
    }
}

def add_vecs(a: Vec2, b: Vec2) -> Vec2 {
    return a + b
}

def scale(v: Vec2, s: float) -> Vec2 {
    return v * s
}

def main() -> void {
}
