# layer1_callable_iter.kn -- Callable and Iterator interfaces with associated types
#
# Callable, Iterator, Into, From are provided by the prelude.

interface Displayable {
    hook display() -> str
}

interface Debuggable {
    hook debug() -> str
}

interface Hashable {
    hook hash() -> int
}

# ---- A simple range iterator -------------------------------------------------

struct RangeIterator {
    current: int
    stop: int
}

impl Iterator for RangeIterator {
    hook next() -> Option[int] {
        if self.current >= self.stop {
            return None
        }
        result: int = self.current
        self.current = self.current + 1
        return Some(result)
    }
}

# ---- A filter iterator wrapping another iterator ----------------------------

struct Filtered {
    inner: RangeIterator
    threshold: int
}

impl Iterator for Filtered {
    hook next() -> Option[int] {
        v: Option[int] = self.inner.next()
        if v == None {
            return None
        }
        x: int = v?
        if x > self.threshold {
            return Some(x)
        }
        return None
    }
}

# ---- From / Into conversions -------------------------------------------------

struct Celsius {
    degrees: float
}

struct Kelvin {
    degrees: float
}

impl From[Celsius] for Kelvin {
    hook from(value: Celsius) -> Kelvin {
        return Kelvin { degrees: value.degrees + 273.15 }
    }
}

impl Into[Kelvin] for Celsius {
    hook into() -> Kelvin {
        return Kelvin { degrees: self.degrees + 273.15 }
    }
}

def main() -> void {
}
