# layer1_comparison.kn -- heterogeneous comparison interfaces (Layer 1 operational core)
# EquatableWith and ComparableWith are provided by the prelude.

# ---- Concrete example --------------------------------------------------------

struct Temperature {
    celsius: float
}

struct Fahrenheit {
    degrees: float
}

impl EquatableWith[Temperature] for Temperature {
    hook ==(rhs: Temperature) -> bool {
        return self.celsius == rhs.celsius
    }
}

impl ComparableWith[Temperature] for Temperature {
    hook <=>(rhs: Temperature) -> Ordering {
        if self.celsius < rhs.celsius { return Ordering:Less }
        if self.celsius > rhs.celsius { return Ordering:Greater }
        return Ordering:Equal
    }
}

impl EquatableWith[Fahrenheit] for Temperature {
    hook ==(rhs: Fahrenheit) -> bool {
        converted: float = (rhs.degrees - 32.0) * 5.0 / 9.0
        return self.celsius == converted
    }
}

# ---- Self-comparable shorthand -----------------------------------------------
# Comparable is provided by the prelude.

interface Equatable: EquatableWith[Self] {
}

struct Score {
    points: int
}

impl EquatableWith[Score] for Score {
    hook ==(rhs: Score) -> bool {
        return self.points == rhs.points
    }
}

impl ComparableWith[Score] for Score {
    hook <=>(rhs: Score) -> Ordering {
        if self.points < rhs.points { return Ordering:Less }
        if self.points > rhs.points { return Ordering:Greater }
        return Ordering:Equal
    }
}

def max_score(a: Score, b: Score) -> Score {
    cmp: Ordering = a <=> b
    if cmp == Ordering:Greater || cmp == Ordering:Equal {
        return a
    }
    return b
}

def main() -> void {
}
