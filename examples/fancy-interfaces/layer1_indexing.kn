# layer1_indexing.kn -- indexing interfaces (Layer 1 operational core)
# IndexableWith and MutableIndexableWith are provided by the prelude.

# ---- Integer-indexed array wrapper ------------------------------------------

struct IntArray {
    data: Vec[int]
}

impl IndexableWith[int] for IntArray {
    hook [](index: int) -> int {
        return self.data.get(index)
    }
}

impl MutableIndexableWith[int] for IntArray {
    hook []=(index: int, value: int) {
        self.data.set(index, value)
    }
}

# ---- String-keyed map wrapper ------------------------------------------------

struct StrMap {
    data: Map[str, str]
}

impl IndexableWith[str] for StrMap {
    hook [](index: str) -> str {
        return self.data.get(index)
    }
}

impl MutableIndexableWith[str] for StrMap {
    hook []=(index: str, value: str) {
        self.data.set(index, value)
    }
}

def main() -> void {
}
