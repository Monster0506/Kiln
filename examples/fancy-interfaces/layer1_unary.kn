# layer1_unary.kn -- unary operation interfaces (Layer 1 operational core)
# Negatable, Invertible, and Normalizeable are provided by the prelude.

# ---- Concrete examples -------------------------------------------------------

struct Vec2 {
    x: float
    y: float
}

impl Negatable for Vec2 {
    hook -() -> Vec2 {
        return Vec2 { x: 0.0 - self.x, y: 0.0 - self.y }
    }
}

impl Normalizeable for Vec2 {
    hook +() -> Vec2 {
        len: float = self.x * self.x + self.y * self.y
        return Vec2 { x: self.x / len, y: self.y / len }
    }
}

struct BitFlags {
    bits: int
}

impl Invertible for BitFlags {
    hook !() -> BitFlags {
        return BitFlags { bits: 0 - self.bits - 1 }
    }
}

struct BoolWrapper {
    value: bool
}

impl Invertible for BoolWrapper {
    hook !() -> BoolWrapper {
        if self.value {
            return BoolWrapper { value: false }
        }
        return BoolWrapper { value: true }
    }
}

def negate_vec(v: Vec2) -> Vec2 {
    return -v
}

def normalize_vec(v: Vec2) -> Vec2 {
    return +v
}

def invert_flags(f: BitFlags) -> BitFlags {
    return !f
}

def main() -> void {
}
