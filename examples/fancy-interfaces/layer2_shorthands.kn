# layer2_shorthands.kn -- closed shorthands (Layer 2)
#
# Closed shorthands restrict heterogeneous interfaces to Self op Self -> Self.
# They are the common case for numeric and algebraic types.

interface AddableWith[Rhs] {
    type Output

    hook +(rhs: Rhs) -> Output
}

interface SubtractableWith[Rhs] {
    type Output

    hook -(rhs: Rhs) -> Output
}

interface MultipliableWith[Rhs] {
    type Output

    hook *(rhs: Rhs) -> Output
}

interface DividableWith[Rhs] {
    type Output

    hook /(rhs: Rhs) -> Output
}

interface RemainderableWith[Rhs] {
    type Output

    hook %(rhs: Rhs) -> Output
}

# ---- Layer 2: closed shorthands ---------------------------------------------

interface Addable: AddableWith[Self] {
}

interface Subtractable: SubtractableWith[Self] {
}

interface Multipliable: MultipliableWith[Self] {
}

interface Dividable: DividableWith[Self] {
}

interface Remainderable: RemainderableWith[Self] {
}

# ---- Concrete example: a 2D vector that forms a group under addition --------

struct Vec2 {
    x: float
    y: float
}

impl AddableWith[Vec2] for Vec2 {
    hook +(rhs: Vec2) -> Vec2 {
        return Vec2 { x: x + rhs.x, y: y + rhs.y }
    }
}

impl SubtractableWith[Vec2] for Vec2 {
    hook -(rhs: Vec2) -> Vec2 {
        return Vec2 { x: x - rhs.x, y: y - rhs.y }
    }
}

impl MultipliableWith[Vec2] for Vec2 {
    hook *(rhs: Vec2) -> Vec2 {
        return Vec2 { x: x * rhs.x, y: y * rhs.y }
    }
}

def dot(a: Vec2, b: Vec2) -> float {
    prod: Vec2 = a * b
    return prod.x + prod.y
}

def main() -> void {
}
