# layer3_collection.kn -- collection and functional semantics (Layer 3)
#
# Iterable, Indexable, Iterator, Collection, Sequence, Callable,
# Predicate, Mapper, and Comparable are provided by the prelude.

interface Copyable {
}

# ---- A concrete sequence type -----------------------------------------------

struct IntSlice {
    data: Vec[int]
    len: int
}

struct IntSliceIter {
    slice: IntSlice
    pos: int
}

impl Iterator for IntSliceIter {
    hook next() -> Option[int] {
        if pos >= slice.len {
            return None
        }
        val: int = slice.data.get(pos)
        pos = pos + 1
        return Some(val)
    }
}

impl Iterable for IntSlice {
    hook iter() -> IntSliceIter {
        return IntSliceIter { slice: self, pos: 0 }
    }
}

impl Indexable for IntSlice {
    hook [](index: int) -> int {
        return data.get(index)
    }
}

# ---- Generic algorithms that work on any Iterable ---------------------------

def count[T: Iterable](col: T) -> int {
    mut n: int = 0
    for _ <- col.iter() {
        n = n + 1
    }
    return n
}

