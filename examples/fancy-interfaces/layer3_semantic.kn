# layer3_semantic.kn -- semantic algebraic interfaces (Layer 3)
#
# These build on Layer 2 shorthands and Layer 1 primitives to express
# mathematical structures: Semigroup, Monoid, Group, Ring, Field, Numeric.
# All of the above, plus AddableWith, SubtractableWith, MultipliableWith,
# DividableWith, Negatable, Zero, One, ComparableWith, Comparable, Addable,
# Subtractable, Multiplicable, Divisible, and Numeric are from the prelude.

# ---- A rational number type that forms a field ------------------------------

struct Rational {
    numer: int
    denom: int
}

impl AddableWith[Rational] for Rational {
    hook +(rhs: Rational) -> Rational {
        n: int = self.numer * rhs.denom + rhs.numer * self.denom
        d: int = self.denom * rhs.denom
        return Rational { numer: n, denom: d }
    }
}

impl SubtractableWith[Rational] for Rational {
    hook -(rhs: Rational) -> Rational {
        n: int = self.numer * rhs.denom - rhs.numer * self.denom
        d: int = self.denom * rhs.denom
        return Rational { numer: n, denom: d }
    }
}

impl MultipliableWith[Rational] for Rational {
    hook *(rhs: Rational) -> Rational {
        return Rational { numer: self.numer * rhs.numer, denom: self.denom * rhs.denom }
    }
}

impl DividableWith[Rational] for Rational {
    hook /(rhs: Rational) -> Rational {
        return Rational { numer: self.numer * rhs.denom, denom: self.denom * rhs.numer }
    }
}

impl Negatable for Rational {
    hook -() -> Rational {
        return Rational { numer: 0 - self.numer, denom: self.denom }
    }
}

impl Zero for Rational {
    hook zero() -> Rational {
        return Rational { numer: 0, denom: 1 }
    }
}

impl One for Rational {
    hook one() -> Rational {
        return Rational { numer: 1, denom: 1 }
    }
}

impl ComparableWith[Rational] for Rational {
    hook <=>(rhs: Rational) -> Ordering {
        lhs_scaled: int = self.numer * rhs.denom
        rhs_scaled: int = rhs.numer * self.denom
        if lhs_scaled < rhs_scaled { return Ordering:Less }
        if lhs_scaled > rhs_scaled { return Ordering:Greater }
        return Ordering:Equal
    }
}

# ---- Generic functions that require algebraic structure ---------------------

def sum[T: Monoid](items: Vec[T]) -> T {
    mut acc: T = T.zero()
    for item <- items {
        acc = acc + item
    }
    return acc
}

def product[T: Ring](items: Vec[T]) -> T {
    mut acc: T = T.one()
    for item <- items {
        acc = acc * item
    }
    return acc
}

