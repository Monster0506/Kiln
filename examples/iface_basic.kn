# iface_basic.kn -- basic interface declarations, required fields, default bodies

# ---- Basic interface declarations --------------------------------------------

interface Drop {
    hook drop() -> void
}

# ---- Interface with required fields ------------------------------------------

interface Named {
    name: str
}

interface Labeled {
    label: str

    hook display_label() -> str {
        return "[{self.label}]"
    }
}

# ---- Interface with default method bodies ------------------------------------

interface Printable {
    hook to_str() -> str

    hook print() -> void {
        print(to_str())
    }

    hook println() -> void {
        print("{to_str()}\n")
    }
}

interface Describable {
    hook describe() -> str

    hook summarize() -> str {
        d: str = describe()
        return "Summary: {d}"
    }

    hook is_blank() -> bool {
        return describe().length() == 0
    }
}

interface Serializable {
    hook to_json() -> str
    hook to_csv() -> str

    hook serialize(format: str) -> str {
        return match format {
            "json" => to_json(),
            "csv" => to_csv(),
            _ => to_json()
        }
    }
}

# ---- Conforming structs with inline hooks ------------------------------------

struct Greeting: Printable {
    message: str
}

impl Printable for Greeting {
    hook to_str() -> str {
        return self.message
    }
}

struct Person: Named, Describable {
    name: str
    age: int
}

impl Describable for Person {
    hook describe() -> str {
        return "{self.name}, age {self.age}"
    }
}

def main() -> void {
}
