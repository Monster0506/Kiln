# iface_hooks.kn -- operator hooks, index/iterator hooks, Self type, generics

# ---- Operator hook signatures ------------------------------------------------

# ---- Index and iterator hooks ------------------------------------------------

interface Container[T]: Indexable[T], Iterable[T] {
    hook contains(item: T) -> bool
    hook is_empty() -> bool {
        return length() == 0
    }
}

# ---- Drop hook ---------------------------------------------------------------

interface Disposable {
    hook drop() -> void
    hook is_disposed() -> bool
}

# ---- Self type inside interfaces ---------------------------------------------

interface Builder[T] {
    hook set_name(n: str) -> Self
    hook set_value(v: T) -> Self
    hook build() -> T
}

interface Cloneable {
    hook clone() -> Self
    hook clone_n(count: int) -> Vec[Self]
}

interface Chainable {
    hook and_then(other: Self) -> Self
    hook or_else(other: Self) -> Self
}

# ---- Generic interface declarations ------------------------------------------

interface Reducer[T, Acc] {
    hook reduce(acc: Acc, item: T) -> Acc
}

interface Converter[From, To] {
    hook convert(value: From) -> To
    hook convert_back(value: To) -> From
}

def main() -> void {
}
