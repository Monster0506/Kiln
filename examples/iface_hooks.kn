# iface_hooks.kn -- operator hooks, index/iterator hooks, Self type, generics

# ---- Operator hook signatures ------------------------------------------------

interface Eq {
    hook ==(other: Self) -> bool
}

interface Comparable: Eq {
    hook <=>(other: Self) -> int

    hook <(other: Self) -> bool {
        return (self <=> other) < 0
    }

    hook >(other: Self) -> bool {
        return (self <=> other) > 0
    }

    hook <=(other: Self) -> bool {
        return (self <=> other) <= 0
    }

    hook >=(other: Self) -> bool {
        return (self <=> other) >= 0
    }
}

interface Addable {
    hook +(other: Self) -> Self
}

interface Subtractable {
    hook -(other: Self) -> Self
}

interface Negatable {
    hook -() -> Self
}

interface Multiplicable {
    hook *(other: Self) -> Self
}

interface Divisible {
    hook /(other: Self) -> Self
}

# ---- Index and iterator hooks ------------------------------------------------

interface Indexable[T] {
    hook [](index: int) -> T
    hook length() -> int
}

interface Iterable[T] {
    hook iter() -> Iterator[T]
}

interface Container[T]: Indexable[T], Iterable[T] {
    hook contains(item: T) -> bool
    hook is_empty() -> bool {
        return length() == 0
    }
}

# ---- Drop hook ---------------------------------------------------------------

interface Disposable {
    hook drop() -> void
    hook is_disposed() -> bool
}

# ---- Self type inside interfaces ---------------------------------------------

interface Builder[T] {
    hook set_name(n: str) -> Self
    hook set_value(v: T) -> Self
    hook build() -> T
}

interface Cloneable {
    hook clone() -> Self
    hook clone_n(count: int) -> Vec[Self]
}

interface Chainable {
    hook and_then(other: Self) -> Self
    hook or_else(other: Self) -> Self
}

# ---- Generic interface declarations ------------------------------------------

interface Mapper[A, B] {
    hook map(item: A) -> B
}

interface Reducer[T, Acc] {
    hook reduce(acc: Acc, item: T) -> Acc
}

interface Converter[From, To] {
    hook convert(value: From) -> To
    hook convert_back(value: To) -> From
}

interface Predicate[T] {
    hook test(item: T) -> bool
    hook negate() -> Self
}

def main() -> void {
}
