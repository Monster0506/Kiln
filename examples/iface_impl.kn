# iface_impl.kn -- impl blocks for struct/interface conformance

# ---- Types that will have impl blocks ----------------------------------------

@derive(Eq, Display)
struct Point: Comparable {
    x: float
    y: float
}

@derive(Eq)
struct Color: Display, Comparable {
    r: int
    g: int
    b: int
}

struct Temperature: Comparable, Display {
    degrees: float
    unit: str
}

struct Velocity: Addable, Subtractable, Display {
    dx: float
    dy: float
}

# ---- Interfaces needed -------------------------------------------------------

interface Addable {
    hook +(other: Self) -> Self
}

interface Subtractable {
    hook -(other: Self) -> Self
}

interface Display {
    hook to_str() -> str
}

interface Comparable: Eq {
    hook <=>(other: Self) -> int
}

interface Eq {
    hook ==(other: Self) -> bool
}

interface Clone {
    hook clone() -> Self
}

# ---- impl blocks for Point --------------------------------------------------
#
# Orphan rule: you may implement an interface for a type if you own the type,
# the interface, or both.

impl Comparable for Point {
    hook <=>(other: Point) -> int {
        dist_self: float = x * x + y * y
        dist_other: float = other.x * other.x + other.y * other.y
        if dist_self < dist_other {
            return -1
        } elif dist_self > dist_other {
            return 1
        } else {
            return 0
        }
    }

    hook ==(other: Point) -> bool {
        return x == other.x && y == other.y
    }
}

impl Display for Point {
    hook to_str() -> str {
        return "Point({x}, {y})"
    }
}

impl Clone for Point {
    hook clone() -> Self {
        return Point { x: x, y: y }
    }
}

# ---- impl blocks for Color --------------------------------------------------

impl Comparable for Color {
    hook <=>(other: Color) -> int {
        self_lum: int = r + g + b
        other_lum: int = other.r + other.g + other.b
        if self_lum < other_lum {
            return -1
        } elif self_lum > other_lum {
            return 1
        } else {
            return 0
        }
    }

    hook ==(other: Color) -> bool {
        return r == other.r && g == other.g && b == other.b
    }
}

impl Display for Color {
    hook to_str() -> str {
        return "rgb({r}, {g}, {b})"
    }
}

# ---- impl blocks for Temperature --------------------------------------------

impl Comparable for Temperature {
    hook <=>(other: Temperature) -> int {
        if degrees < other.degrees {
            return -1
        } elif degrees > other.degrees {
            return 1
        } else {
            return 0
        }
    }

    hook ==(other: Temperature) -> bool {
        return degrees == other.degrees
    }
}

impl Display for Temperature {
    hook to_str() -> str {
        return "{degrees}{unit}"
    }
}

# ---- impl blocks for Velocity -----------------------------------------------

impl Addable for Velocity {
    hook +(other: Velocity) -> Velocity {
        return Velocity { dx: dx + other.dx, dy: dy + other.dy }
    }
}

impl Subtractable for Velocity {
    hook -(other: Velocity) -> Velocity {
        return Velocity { dx: dx - other.dx, dy: dy - other.dy }
    }
}

impl Display for Velocity {
    hook to_str() -> str {
        return "Velocity({dx}, {dy})"
    }
}

def main() -> void {
}
