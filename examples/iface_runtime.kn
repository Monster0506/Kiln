# iface_runtime.kn -- isinstance, implements, generic constrained functions

interface Display {
    hook to_str() -> str
}

interface Comparable: Eq {
    hook <=>(other: Self) -> int
}

interface Eq {
    hook ==(other: Self) -> bool
}

interface Clone {
    hook clone() -> Self
}

interface Addable {
    hook +(other: Self) -> Self
}

@derive(Eq, Display)
struct Point: Comparable {
    x: float
    y: float
}

impl Comparable for Point {
    hook <=>(other: Point) -> int {
        lx: float = x * x + y * y
        rx: float = other.x * other.x + other.y * other.y
        if lx < rx { return -1 }
        if lx > rx { return 1 }
        return 0
    }
    hook ==(other: Point) -> bool { return x == other.x && y == other.y }
}

@derive(Eq, Display)
struct Color: Comparable {
    r: int
    g: int
    b: int
}

impl Comparable for Color {
    hook <=>(other: Color) -> int {
        ls: int = r + g + b
        rs: int = other.r + other.g + other.b
        if ls < rs { return -1 }
        if ls > rs { return 1 }
        return 0
    }
    hook ==(other: Color) -> bool {
        return r == other.r && g == other.g && b == other.b
    }
}

# ---- isinstance usage --------------------------------------------------------

def describe_value(x: Display) -> str {
    base: str = x.to_str()
    if isinstance(x, Point) {
        return "point: {base}"
    } elif isinstance(x, Color) {
        return "color: {base}"
    } else {
        return "unknown: {base}"
    }
}

def type_check_demo(items: Vec[Display]) -> void {
    for item <- items {
        if isinstance(item, Point) {
            print("got a Point: {item.to_str()}")
        } elif isinstance(item, Color) {
            print("got a Color: {item.to_str()}")
        } else {
            print("other: {item.to_str()}")
        }
    }
}

# ---- implements usage --------------------------------------------------------

def compare_if_possible(a: Display, b: Display) -> str {
    if implements(a, Comparable) && implements(b, Comparable) {
        return "both comparable"
    } elif implements(a, Comparable) {
        return "only a is comparable"
    } elif implements(b, Comparable) {
        return "only b is comparable"
    } else {
        return "neither is comparable"
    }
}

def try_add(a: Display, b: Display) -> str {
    if implements(a, Addable) && implements(b, Addable) {
        return "can add"
    }
    return "cannot add"
}

def check_cloneable(items: Vec[Display]) -> int {
    count: int = 0
    for item <- items {
        if implements(item, Clone) {
            count = count + 1
        }
    }
    return count
}

# ---- Generic functions constrained by interface -----------------------------

def max_of[T: Comparable](a: T, b: T) -> T {
    if (a <=> b) >= 0 {
        return a
    }
    return b
}

def min_of[T: Comparable](a: T, b: T) -> T {
    if (a <=> b) <= 0 {
        return a
    }
    return b
}

def print_all[T: Display](items: Vec[T]) -> void {
    for item <- items {
        print(item.to_str())
    }
}

def clone_all[T: Clone](items: Vec[T]) -> Vec[T] {
    out: Vec[T] = Vec.new()
    for item <- items {
        out.add(item.clone())
    }
    return out
}

def are_all_equal[T: Eq](items: Vec[T], target: T) -> bool {
    for item <- items {
        if !(item == target) {
            return false
        }
    }
    return true
}

def find_max[T: Comparable](items: Vec[T]) -> T {
    best: T = items[0]
    for item <- items {
        if (item <=> best) > 0 {
            best = item
        }
    }
    return best
}

