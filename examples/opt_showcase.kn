BASE: int = 100
SCALE: float = 2.0
mut INIT_ONLY: int = 42
def add_two(a: int, b: int) -> int {
    return a + b
}
def dead_helper(n: int) -> int {
    return n * 2
}
def main() -> void {
    cf_int_add: int = 2 + 3           # -> 5
    cf_int_mul: int = 10 * 4          # -> 40
    cf_int_div: int = 100 / 5         # -> 20
    cf_int_sub: int = 20 - 8          # -> 12
    cf_float: float = 1.5 + 0.5       # -> 2.0
    cf_bool: bool = true && false      # -> false
    cf_or: bool = true || false        # -> true
    cf_cmp_gt: bool = 3 > 1            # -> true
    cf_cmp_eq: bool = 5 == 5           # -> true
    cf_cmp_ne: bool = 2 != 2           # -> false
    cf_unary_neg: int = -5             # unary fold -> Int(-5)
    cf_unary_not: bool = !true         # -> false
    x: int = 7
    ai_add0: int = x + 0      # -> x (additive identity)
    ai_0add: int = 0 + x      # -> x (commuted)
    ai_sub0: int = x - 0      # -> x (subtractive identity)
    ai_mul1: int = x * 1      # -> x (multiplicative identity)
    ai_1mul: int = 1 * x      # -> x (commuted)
    ai_mul0: int = x * 0      # -> 0 (x is pure Ident)
    ai_0mul: int = 0 * x      # -> 0
    ai_div1: int = x / 1      # -> x (division identity)
    ai_mod1: int = x % 1      # -> 0 (modulo one)
    ai_self_sub: int = x - x  # -> 0 (self-subtraction)
    ai_self_mod: int = x % x  # -> 0 (self-modulo)
    ai_double_neg: int = -(-x)
    f: float = 2.5
    ai_add0f: float = f + 0.0      # -> f
    ai_sub0f: float = f - 0.0      # -> f
    ai_mul1f: float = f * 1.0      # -> f
    ai_div1f: float = f / 1.0      # -> f
    ai_double_neg_f: float = -(-f) # -> f
    b: bool = true
    ai_double_not: bool = !!b      # -> b
    bv: bool = false
    bs_true_and: bool = true && bv    # -> bv (identity for AND)
    bs_false_or: bool = false || bv   # -> bv (identity for OR)
    bs_false_and: bool = false && bv  # -> false (bv is pure)
    bs_true_or: bool = true || bv     # -> true  (bv is pure)
    bs_or_true: bool = bv || true     # -> true  (bv is pure)
    bs_and_false: bool = bv && false  # -> false (bv is pure)
    bs_idem_and: bool = bv && bv      # -> bv (idempotent AND)
    bs_idem_or: bool = bv || bv       # -> bv (idempotent OR)
    bs_eq_true: bool = bv == true     # -> bv
    bs_eq_false: bool = bv == false   # -> !bv
    bs_ne_true: bool = bv != true     # -> !bv
    bs_ne_false: bool = bv != false   # -> bv
    a: bool = true
    bs_demorgan_and: bool = !(a && bv)  # -> !a || !bv
    bs_demorgan_or: bool = !(a || bv)   # -> !a && !bv
    cx: int = 9
    cs_eq: bool = cx == cx   # -> true
    cs_ne: bool = cx != cx   # -> false
    cs_lt: bool = cx < cx    # -> false
    cs_gt: bool = cx > cx    # -> false
    cs_le: bool = cx <= cx   # -> true
    cs_ge: bool = cx >= cx   # -> true
    y: int = 9
    ng: int = 4
    sr_double: int = y * 2       # -> y + y (mul-by-2)
    sr_2mul: int = 2 * y         # -> y + y
    sr_zero_sub: int = 0 - y     # -> -y
    sr_mul_neg1: int = y * -1    # -> -y
    sr_neg1_mul: int = -1 * y    # -> -y
    sr_sub_neg: int = y - (-ng)  # -> y + ng (sub of negation)
    sr_cast_int: int = x as int       # -> x (already int)
    sr_cast_float: float = f as float # -> f (already float)
    cp_a: int = 3
    cp_b: int = 4
    cp_sum: int = cp_a + cp_b      # -> 3+4 after prop -> 7 after fold
    cp_p: float = 1.5
    cp_q: float = 0.5
    cp_pq: float = cp_p + cp_q    # -> 2.0
    cp_flag: bool = true
    cp_and: bool = cp_flag && false  # -> false (flag inlined, then fold)
    g_base: int = BASE + 1       # BASE inlined as 100 -> 101
    g_scale: float = SCALE       # SCALE inlined as 2.0
    g_init: int = INIT_ONLY      # promoted to immutable, inlined as 42
    mut chosen: int = 0
    chosen = 1
    dead_binding: int = 123
    mut rx: int = 5
    rx = rx    # removed
    mut inlined: int = add_two(3, 4)   # -> 7 (body inlined)
    mut sum: int = 0
    mut i: int = 0
    while i < 5 {
        sum = sum + i
        i = i + 1
    }
    println(chosen)   # 1
    println(cp_sum)   # 7
    println(g_base)   # 101
    println(g_init)   # 42
    println(inlined)  # 7
    println(sum)      # 10  (0+1+2+3+4)
    println(rx)       # 5
}
def dead_early_return(n: int) -> int {
    return n + 1
}