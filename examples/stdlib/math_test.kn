import math.constants { pi, e, sqrt2, sqrt3, ln_2, ln_10, phi }

# ---- Batch 1: constants -------------------------------------------------------

@test
def test_pi() -> void {
    val: float = pi()
    assert(val > 3.14159)
    assert(val < 3.14160)
}

@test
def test_e() -> void {
    val: float = e()
    assert(val > 2.71828)
    assert(val < 2.71829)
}

@test
def test_sqrt2() -> void {
    val: float = sqrt2()
    assert(val > 1.41421)
    assert(val < 1.41422)
}

@test
def test_sqrt3() -> void {
    val: float = sqrt3()
    assert(val > 1.73205)
    assert(val < 1.73206)
}

@test
def test_ln_2() -> void {
    val: float = ln_2()
    assert(val > 0.69314)
    assert(val < 0.69315)
}

@test
def test_phi() -> void {
    val: float = phi()
    assert(val > 1.61803)
    assert(val < 1.61804)
}

# ---- Batch 1: rounding on float -----------------------------------------------

@test
def test_floor_positive() -> void {
    x: float = 3.7
    assert(x.floor() == 3.0)
}

@test
def test_floor_negative() -> void {
    x: float = -1.3
    assert(x.floor() == -2.0)
}

@test
def test_floor_zero() -> void {
    x: float = 0.0
    assert(x.floor() == 0.0)
}

@test
def test_ceil_positive() -> void {
    x: float = 3.2
    assert(x.ceil() == 4.0)
}

@test
def test_ceil_negative() -> void {
    x: float = -1.7
    assert(x.ceil() == -1.0)
}

@test
def test_round_up() -> void {
    x: float = 3.5
    assert(x.round() == 4.0)
}

@test
def test_round_down() -> void {
    x: float = 3.4
    assert(x.round() == 3.0)
}

@test
def test_round_negative() -> void {
    x: float = -2.5
    assert(x.round() == -3.0)
}

@test
def test_trunc_positive() -> void {
    x: float = 3.9
    assert(x.trunc() == 3.0)
}

@test
def test_trunc_negative() -> void {
    x: float = -3.9
    assert(x.trunc() == -3.0)
}

@test
def test_fract_positive() -> void {
    x: float = 3.75
    f: float = x.fract()
    assert(f > 0.74)
    assert(f < 0.76)
}

@test
def test_fract_negative() -> void {
    x: float = -1.25
    f: float = x.fract()
    assert(f > -0.26)
    assert(f < -0.24)
}

# ---- Batch 1: FloatMath on int ------------------------------------------------

@test
def test_floor_int() -> void {
    n: int = 5
    val: float = n.floor()
    assert(val == 5.0)
}

@test
def test_ceil_int() -> void {
    n: int = 3
    val: float = n.ceil()
    assert(val == 3.0)
}

@test
def test_trunc_int() -> void {
    n: int = 7
    val: float = n.trunc()
    assert(val == 7.0)
}

# ---- Batch 2: sqrt, cbrt, pow, powi, hypot ------------------------------------

@test
def test_sqrt() -> void {
    x: float = 9.0
    assert(x.sqrt() == 3.0)
}

@test
def test_sqrt_two() -> void {
    val: float = 2.0.sqrt()
    assert(val > 1.41421)
    assert(val < 1.41422)
}

@test
def test_cbrt() -> void {
    x: float = 27.0
    val: float = x.cbrt()
    assert(val > 2.99)
    assert(val < 3.01)
}

@test
def test_pow() -> void {
    x: float = 2.0
    assert(x.pow(10.0) == 1024.0)
}

@test
def test_powi() -> void {
    x: float = 3.0
    assert(x.powi(3) == 27.0)
}

@test
def test_hypot() -> void {
    x: float = 3.0
    val: float = x.hypot(4.0)
    assert(val == 5.0)
}

@test
def test_sqrt_int() -> void {
    n: int = 16
    val: float = n.sqrt()
    assert(val == 4.0)
}

# ---- Batch 3: exp and log -----------------------------------------------------

@test
def test_exp() -> void {
    x: float = 1.0
    val: float = x.exp()
    assert(val > 2.71828)
    assert(val < 2.71829)
}

@test
def test_exp_zero() -> void {
    x: float = 0.0
    assert(x.exp() == 1.0)
}

@test
def test_exp2() -> void {
    x: float = 10.0
    assert(x.exp2() == 1024.0)
}

@test
def test_ln() -> void {
    val: float = e().ln()
    assert(val > 0.9999)
    assert(val < 1.0001)
}

@test
def test_log2() -> void {
    x: float = 8.0
    val: float = x.log2()
    assert(val > 2.999)
    assert(val < 3.001)
}

@test
def test_log10() -> void {
    x: float = 100.0
    val: float = x.log10()
    assert(val > 1.999)
    assert(val < 2.001)
}

@test
def test_log() -> void {
    x: float = 8.0
    val: float = x.log(2.0)
    assert(val > 2.999)
    assert(val < 3.001)
}

# ---- Batch 4: trig ------------------------------------------------------------

@test
def test_sin_zero() -> void {
    x: float = 0.0
    assert(x.sin() == 0.0)
}

@test
def test_cos_zero() -> void {
    x: float = 0.0
    assert(x.cos() == 1.0)
}

@test
def test_sin_pi_half() -> void {
    x: float = pi() / 2.0
    val: float = x.sin()
    assert(val > 0.9999)
    assert(val < 1.0001)
}

@test
def test_cos_pi() -> void {
    x: float = pi()
    val: float = x.cos()
    assert(val > -1.0001)
    assert(val < -0.9999)
}

@test
def test_tan_zero() -> void {
    x: float = 0.0
    assert(x.tan() == 0.0)
}

@test
def test_atan2() -> void {
    y: float = 1.0
    val: float = y.atan2(1.0)
    expected: float = pi() / 4.0
    assert(val > expected - 0.0001)
    assert(val < expected + 0.0001)
}

@test
def test_asin() -> void {
    x: float = 1.0
    val: float = x.asin()
    expected: float = pi() / 2.0
    assert(val > expected - 0.0001)
    assert(val < expected + 0.0001)
}

@test
def test_acos() -> void {
    x: float = 1.0
    val: float = x.acos()
    assert(val > -0.0001)
    assert(val < 0.0001)
}

@test
def test_atan() -> void {
    x: float = 1.0
    val: float = x.atan()
    expected: float = pi() / 4.0
    assert(val > expected - 0.0001)
    assert(val < expected + 0.0001)
}

# ---- Batch 5: hyperbolic + predicates + isclose --------------------------------

@test
def test_sinh_zero() -> void {
    x: float = 0.0
    assert(x.sinh() == 0.0)
}

@test
def test_cosh_zero() -> void {
    x: float = 0.0
    assert(x.cosh() == 1.0)
}

@test
def test_tanh_zero() -> void {
    x: float = 0.0
    assert(x.tanh() == 0.0)
}

@test
def test_to_degrees() -> void {
    x: float = pi()
    val: float = x.to_degrees()
    assert(val > 179.999)
    assert(val < 180.001)
}

@test
def test_to_radians() -> void {
    x: float = 180.0
    val: float = x.to_radians()
    assert(val > pi() - 0.0001)
    assert(val < pi() + 0.0001)
}

@test
def test_fabs() -> void {
    x: float = -3.5
    assert(x.fabs() == 3.5)
}

@test
def test_fmin() -> void {
    x: float = 3.0
    assert(x.fmin(5.0) == 3.0)
    assert(x.fmin(1.0) == 1.0)
}

@test
def test_fmax() -> void {
    x: float = 3.0
    assert(x.fmax(5.0) == 5.0)
    assert(x.fmax(1.0) == 3.0)
}

@test
def test_fclamp() -> void {
    x: float = 5.0
    assert(x.fclamp(0.0, 3.0) == 3.0)
    assert(x.fclamp(6.0, 10.0) == 6.0)
    assert(x.fclamp(0.0, 10.0) == 5.0)
}

@test
def test_is_finite() -> void {
    x: float = 1.0
    assert(x.is_finite())
}

@test
def test_isclose_equal() -> void {
    a: float = 1.0
    b: float = 1.0000000001
    assert(a.isclose(b, 0.0, 0.00001))
}

@test
def test_isclose_not_equal() -> void {
    a: float = 1.0
    b: float = 2.0
    close: bool = a.isclose(b, 0.0, 0.0001)
    assert(close == false)
}

# ---- Batch 6: IntMath on int --------------------------------------------------

@test
def test_ipow() -> void {
    n: int = 2
    assert(n.ipow(10) == 1024)
}

@test
def test_gcd() -> void {
    n: int = 12
    assert(n.gcd(8) == 4)
}

@test
def test_lcm() -> void {
    n: int = 4
    assert(n.lcm(6) == 12)
}

@test
def test_imin() -> void {
    n: int = 5
    assert(n.imin(3) == 3)
    assert(n.imin(7) == 5)
}

@test
def test_imax() -> void {
    n: int = 5
    assert(n.imax(3) == 5)
    assert(n.imax(7) == 7)
}

@test
def test_iclamp() -> void {
    n: int = 10
    assert(n.iclamp(0, 5) == 5)
    assert(n.iclamp(15, 20) == 15)
    assert(n.iclamp(0, 20) == 10)
}

@test
def test_factorial() -> void {
    assert(5.factorial() == 120)
    assert(0.factorial() == 1)
}

@test
def test_comb() -> void {
    assert(5.comb(2) == 10)
    assert(4.comb(0) == 1)
}

@test
def test_perm() -> void {
    assert(5.perm(2) == 20)
    assert(4.perm(1) == 4)
}
