# Result[T, E] tests: construction, pattern matching, and ? propagation

@test
def test_ok_value() -> void {
    r: Result[int, str] = Result:Ok { value: 42 }
    match r {
        Ok { value: v } => assert(v == 42),
        Err { error: _ } => panic('expected Ok')
    }
}

@test
def test_err_value() -> void {
    r: Result[int, str] = Result:Err { error: 'oops' }
    match r {
        Ok { value: _ } => panic('expected Err'),
        Err { error: e } => assert(e == 'oops')
    }
}

@test
def test_ok_zero() -> void {
    r: Result[int, str] = Result:Ok { value: 0 }
    match r {
        Ok { value: v } => assert(v == 0),
        Err { error: _ } => panic('expected Ok')
    }
}

@test
def test_err_str() -> void {
    r: Result[int, str] = Result:Err { error: 'fail' }
    match r {
        Ok { value: _ } => panic('expected Err'),
        Err { error: e } => assert(e == 'fail')
    }
}

def parse_positive(n: int) -> Result[int, str] {
    if n > 0 {
        return Result:Ok { value: n }
    }
    return Result:Err { error: 'not positive' }
}

def double_positive(n: int) -> Result[int, str] {
    v: int = parse_positive(n)?
    return Result:Ok { value: v * 2 }
}

@test
def test_unwrap_ok_propagates() -> void {
    r: Result[int, str] = double_positive(5)
    match r {
        Ok { value: v } => assert(v == 10),
        Err { error: _ } => panic('expected Ok')
    }
}

@test
def test_unwrap_err_propagates() -> void {
    r: Result[int, str] = double_positive(-1)
    match r {
        Ok { value: _ } => panic('expected Err'),
        Err { error: e } => assert(e == 'not positive')
    }
}
