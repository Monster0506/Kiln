# structs_methods.kn -- struct with inline methods, private fields

# ---- Private fields ----------------------------------------------------------

struct BankAccount {
    owner: str
    priv balance: float
    priv transaction_count: int
}

# ---- Struct with inline methods ----------------------------------------------

struct Counter {
    priv value: int

    def get() -> int {
        return self.value
    }

    def reset() -> void {
        self.value = 0
    }

    def increment() -> void {
        self.value = self.value + 1
    }

    def decrement() -> void {
        self.value = self.value - 1
    }

    def add(n: int) -> void {
        self.value = self.value + n
    }

    def sub(n: int) -> void {
        self.value = self.value - n
    }

    def is_zero() -> bool {
        return self.value == 0
    }
}

struct StringBuilder {
    priv parts: Vec[str]

    def append(s: str) -> void {
        self.parts.add(s)
    }

    def append_line(s: str) -> void {
        self.parts.add(s)
        self.parts.add("\n")
    }

    def build() -> str {
        mut result: str = ""
        for part <- self.parts {
            result = "{result}{part}"
        }
        return result
    }

    def length() -> int {
        return self.parts.length()
    }

    def clear() -> void {
        self.parts = Vec.new()
    }
}

struct Stack[T] {
    priv items: Vec[T]
    priv size: int

    def push(item: T) -> void {
        self.items.add(item)
        self.size = self.size + 1
    }

    def pop() -> Option[T] {
        if self.size == 0 {
            return None
        }
        self.size = self.size - 1
        return Some { value: self.items[self.size] }
    }

    def peek() -> Option[T] {
        if self.size == 0 {
            return None
        }
        return Some { value: self.items[self.size - 1] }
    }

    def is_empty() -> bool {
        return self.size == 0
    }

    def length() -> int {
        return self.size
    }
}

def main() -> void {
}
