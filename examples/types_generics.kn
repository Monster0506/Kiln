# types_generics.kn -- generic type parameters, bounds, and instantiation

# ---- Unconstrained generic parameters ----------------------------------------

def identity[T](x: T) -> T {
    return x
}

def swap[A, B](a: A, b: B) -> (B, A) {
    return (b, a)
}

def pair[A, B](a: A, b: B) -> (A, B) {
    return (a, b)
}

def first[T](a: T, b: T) -> T {
    return a
}

def second[T](a: T, b: T) -> T {
    return b
}

# ---- Bounded generic parameters ----------------------------------------------

def max_of[T: Comparable](a: T, b: T) -> T {
    if (a <=> b) >= 0 {
        return a
    }
    return b
}

def min_of[T: Comparable](a: T, b: T) -> T {
    if (a <=> b) <= 0 {
        return a
    }
    return b
}

def sort_pair[T: Comparable](a: T, b: T) -> (T, T) {
    if (a <=> b) <= 0 {
        return (a, b)
    }
    return (b, a)
}

def add_generic[T: Addable](a: T, b: T) -> T {
    return a + b
}

def print_item[T: Display](item: T) -> void {
    print("{item}")
}

def are_equal[T: Eq](a: T, b: T) -> bool {
    return a == b
}

# ---- Generic structs ---------------------------------------------------------

struct Pair[A, B] {
    first: A
    second: B
}

struct Triple[A, B, C] {
    first: A
    second: B
    third: C
}

struct Box[T] {
    value: T
}

struct Wrapper[T] {
    inner: T
    label: str
}

# ---- Generic struct with methods ---------------------------------------------

struct Stack[T] {
    priv items: Vec[T]

    def push(item: T) -> void {
        self.items.add(item)
    }

    def pop() -> Option[T] {
        n: int = self.items.length()
        if n == 0 {
            return None
        }
        return Some { value: self.items[n - 1] }
    }

    def peek() -> Option[T] {
        n: int = self.items.length()
        if n == 0 {
            return None
        }
        v: T = self.items[n - 1]
        return Some { value: v }
    }

    def is_empty() -> bool {
        return self.items.length() == 0
    }

    def size() -> int {
        return self.items.length()
    }
}

# ---- Generic enums -----------------------------------------------------------

enum Either[L, R] {
    Left { value: L }
    Right { value: R }
}

# ---- Generic functions with Vec[T] -------------------------------------------

def map_vec[T, U](items: Vec[T], f: Callable[(T), U]) -> Vec[U] {
    out: Vec[U] = Vec.new()
    for item <- items {
        out.add(f(item))
    }
    return out
}

def filter_vec[T](items: Vec[T], pred: Callable[(T), bool]) -> Vec[T] {
    out: Vec[T] = Vec.new()
    for item <- items {
        if pred(item) {
            out.add(item)
        }
    }
    return out
}

def reduce[T](items: Vec[T], init: T, f: Callable[(T, T), T]) -> T {
    mut acc: T = init
    for item <- items {
        acc = f(acc, item)
    }
    return acc
}

def find_first[T](items: Vec[T], pred: Callable[(T), bool]) -> Option[T] {
    for item <- items {
        if pred(item) {
            return Some { value: item }
        }
    }
    return None
}

def all_match[T](items: Vec[T], pred: Callable[(T), bool]) -> bool {
    for item <- items {
        if !pred(item) {
            return false
        }
    }
    return true
}

def any_match[T](items: Vec[T], pred: Callable[(T), bool]) -> bool {
    for item <- items {
        if pred(item) {
            return true
        }
    }
    return false
}

# ---- Nested generic types at call sites -------------------------------------

def demo_nested_generic() -> void {
    pairs: Vec[Pair[int, str]] = Vec.new()
    p: Pair[int, str] = Pair { first: 1, second: "one" }
    pairs.add(p)

    box_opt: Box[Option[int]] = Box { value: Some { value: 42 } }
    stack_of_vecs: Stack[Vec[int]] = Stack { items: Vec.new() }
}

def main() -> void {
    demo_nested_generic()
}
