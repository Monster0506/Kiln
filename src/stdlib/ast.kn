# AST types available inside processor bodies.
# All types are @builtin -- the compiler supplies the runtime representation.
# Declared here so the analyzer can type-check processor signatures and bodies.

@builtin
struct Param {
    name: str
    ty: str
}

@builtin
struct StructField {
    name: str
    ty: str
    mutable: bool
}

# Stand-in for annotation argument values (Map[str, scalar] once Map lands).
@builtin
struct AnnotArgs {
}

@builtin
enum Stmt {
    VarDecl { name: str ty: str }
    Assign { target: str }
    Return
    Expr
    If
    While
    Other
}

@builtin
enum Expr {
    Int { value: int }
    Str { value: str }
    Bool { value: bool }
    Ident { name: str }
    Call { callee: str }
    Other
}

@builtin
struct Block {
    stmts: Vec[Stmt]
}

@builtin
struct FnDecl {
    name: str
    params: Vec[Param]
    return_type: str
    body: Block
    annot: AnnotArgs
}

@builtin
struct StructDecl {
    name: str
    fields: Vec[StructField]
}

@builtin
struct EnumDecl {
    name: str
    variants: Vec[str]
}

@builtin
enum Decl {
    Fn { decl: FnDecl }
    Struct { decl: StructDecl }
    Enum { decl: EnumDecl }
}

export { Param, StructField, AnnotArgs, Stmt, Expr, Block, FnDecl, StructDecl, EnumDecl, Decl }
