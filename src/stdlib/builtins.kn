# Kiln stdlib: builtin types and functions.
# The compiler provides all @builtin implementations.

struct VecIter[T] {
    vec: Vec[T]
    index: int
}

@builtin
struct Vec[T] {
    def new() -> Vec[T]
    def add(item: T) -> void
    def len() -> int
    def get(index: int) -> T
    def set(index: int, item: T) -> void
    def remove(index: int) -> T
    def clear() -> void
}

@builtin
@impure
def __kiln_print(s: str) -> void

@builtin
@impure
def __kiln_println(s: str) -> void

@builtin
def __kiln_int_to_str(n: int) -> str

@builtin
def __kiln_float_to_str(f: float) -> str

@builtin
def __kiln_bool_to_str(b: bool) -> str

@builtin
def __kiln_str_concat(a: str, b: str) -> str

@builtin
def __kiln_str_byte_len(s: str) -> int

@builtin
def __kiln_str_codepoint_len(s: str) -> int

@builtin
def __kiln_str_char_at(s: str, i: int) -> str

@builtin
def __kiln_str_byte_at(s: str, i: int) -> int

@builtin
def __kiln_str_slice(s: str, start: int, end: int) -> str

@builtin
def __kiln_str_starts_with(s: str, prefix: str) -> bool

@builtin
def __kiln_str_ends_with(s: str, suffix: str) -> bool

@builtin
def __kiln_str_contains(s: str, needle: str) -> bool

@builtin
def __kiln_str_find(s: str, needle: str) -> int

@builtin
def __kiln_str_find_from(s: str, needle: str, start: int) -> int

@builtin
def __kiln_str_to_upper(s: str) -> str

@builtin
def __kiln_str_to_lower(s: str) -> str

@builtin
def __kiln_str_reverse(s: str) -> str

@builtin
def __kiln_str_trim(s: str) -> str

@builtin
def __kiln_str_trim_start(s: str) -> str

@builtin
def __kiln_str_trim_end(s: str) -> str

@builtin
def __kiln_str_replace(s: str, from: str, to: str) -> str

@builtin
def __kiln_str_repeat(s: str, n: int) -> str

@builtin
def __kiln_str_split(s: str, sep: str) -> Vec[str]

@builtin
def __kiln_str_split_whitespace(s: str) -> Vec[str]

@builtin
def __kiln_str_chars(s: str) -> Vec[str]

@builtin
def __kiln_str_bytes_vec(s: str) -> Vec[int]

@builtin
def __kiln_str_pad_start(s: str, width: int, pad: str) -> str

@builtin
def __kiln_str_pad_end(s: str, width: int, pad: str) -> str

@builtin
def __kiln_str_remove_prefix(s: str, prefix: str) -> str

@builtin
def __kiln_str_remove_suffix(s: str, suffix: str) -> str

@builtin
def __kiln_str_parse_int(s: str) -> Option[int]

@builtin
def __kiln_str_parse_float(s: str) -> Option[float]

@builtin
def len(x: str) -> int

@builtin
@impure
def panic(msg: str) -> void

@builtin
@impure
def assert(cond: bool) -> void

@builtin
@impure
def clock_ms() -> int

@builtin
struct Exception {}

# Mutex[T] -- interior-mutability wrapper.
# Declared invariant in T by the compiler (see variance pass in analyzer/mod.rs).
@builtin
struct Mutex[T] {
    def new(value: T) -> Mutex[T]
    def lock() -> T
    def unlock(value: T) -> void
}

@builtin
struct RangeIter {
    current: int
    limit:   int
}

@builtin
struct Range {
    start: int
    end:   int
}

export {
    VecIter, Vec,
    __kiln_print, __kiln_println,
    __kiln_int_to_str, __kiln_float_to_str, __kiln_bool_to_str,
    __kiln_str_concat,
    __kiln_str_byte_len, __kiln_str_codepoint_len,
    __kiln_str_char_at, __kiln_str_byte_at,
    __kiln_str_slice, __kiln_str_starts_with, __kiln_str_ends_with,
    __kiln_str_contains, __kiln_str_find, __kiln_str_find_from,
    __kiln_str_to_upper, __kiln_str_to_lower, __kiln_str_reverse,
    __kiln_str_trim, __kiln_str_trim_start, __kiln_str_trim_end,
    __kiln_str_replace, __kiln_str_repeat,
    __kiln_str_split, __kiln_str_split_whitespace,
    __kiln_str_chars, __kiln_str_bytes_vec,
    __kiln_str_pad_start, __kiln_str_pad_end,
    __kiln_str_remove_prefix, __kiln_str_remove_suffix,
    __kiln_str_parse_int, __kiln_str_parse_float,
    len, panic, assert, clock_ms,
    Exception,
    Mutex,
    RangeIter, Range
}

