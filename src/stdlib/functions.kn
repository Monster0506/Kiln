# Kiln stdlib: standard functions available to all programs.

def print[T: Display](item: T) -> void {
    __kiln_print(item.to_str())
}

def println[T: Display](item: T) -> void {
    __kiln_println(item.to_str())
}

def range(start: int, stop: int, step: int) -> Vec[int] {
    result: Vec[int] = Vec.new()
    mut i: int = start
    while i < stop {
        result.add(i)
        i = i + step
    }
    return result
}

def range(start: int, stop: int) -> Vec[int] {
    return range(start, stop, 1)
}

def range(stop: int) -> Vec[int] {
    return range(0, stop, 1)
}

def len[T: Sized](x: T) -> int {
    return x.len()
}

export { print, println, range, len }
