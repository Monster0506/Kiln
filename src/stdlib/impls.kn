# ---- Conformance: str -------------------------------------------------------

impl Sized for str {
    def len() -> int { return __kiln_str_codepoint_len(self) }
}

impl Clone for str { hook clone() -> str {} }
impl Eq for str {}
impl PartialEq for str { hook ==(other: str) -> bool {} }
impl Hash for str { hook hash() -> int {} }
impl Ord for str { hook <=>(other: str) -> Ordering {} }
impl PartialOrd for str { hook <(other: str) -> bool {} }
impl Debug for str { hook debug_str() -> str {} }
impl Default for str { @static hook default() -> str { return '' } }
impl AddableWith[str] for str { hook +(rhs: str) -> str { return __kiln_str_concat(self, rhs) } }
impl Addable for str { hook +(rhs: str) -> str { return __kiln_str_concat(self, rhs) } }
impl Zero for str { @static hook zero() -> str { return '' } }
impl Semigroup for str {}
impl Monoid for str {}
impl IndexableWith[int] for str { hook [](index: int) -> str {} }
impl Indexable for str {}

impl StringMethods for str {
    def length() -> int { return __kiln_str_codepoint_len(self) }
    def byte_length() -> int { return __kiln_str_byte_len(self) }
    def is_empty() -> bool { return __kiln_str_byte_len(self) == 0 }
    def char_at(i: int) -> str { return __kiln_str_char_at(self, i) }
    def byte_at(i: int) -> int { return __kiln_str_byte_at(self, i) }
    def slice(start: int, end: int) -> str { return __kiln_str_slice(self, start, end) }
    def starts_with(prefix: str) -> bool { return __kiln_str_starts_with(self, prefix) }
    def ends_with(suffix: str) -> bool { return __kiln_str_ends_with(self, suffix) }
    def contains(needle: str) -> bool { return __kiln_str_contains(self, needle) }
    def find(needle: str) -> int { return __kiln_str_find(self, needle) }
    def find_from(needle: str, start: int) -> int { return __kiln_str_find_from(self, needle, start) }
    def to_upper() -> str { return __kiln_str_to_upper(self) }
    def to_lower() -> str { return __kiln_str_to_lower(self) }
    def reverse() -> str { return __kiln_str_reverse(self) }
    def trim() -> str { return __kiln_str_trim(self) }
    def trim_start() -> str { return __kiln_str_trim_start(self) }
    def trim_end() -> str { return __kiln_str_trim_end(self) }
    def replace(from: str, to: str) -> str { return __kiln_str_replace(self, from, to) }
    def repeat(n: int) -> str { return __kiln_str_repeat(self, n) }
    def split(sep: str) -> Vec[str] { return __kiln_str_split(self, sep) }
    def split_whitespace() -> Vec[str] { return __kiln_str_split_whitespace(self) }
    def chars() -> Vec[str] { return __kiln_str_chars(self) }
    def bytes() -> Vec[int] { return __kiln_str_bytes_vec(self) }
    def pad_start(width: int, pad: str) -> str { return __kiln_str_pad_start(self, width, pad) }
    def pad_end(width: int, pad: str) -> str { return __kiln_str_pad_end(self, width, pad) }
    def remove_prefix(prefix: str) -> str { return __kiln_str_remove_prefix(self, prefix) }
    def remove_suffix(suffix: str) -> str { return __kiln_str_remove_suffix(self, suffix) }
    def parse_int() -> Option[int] { return __kiln_str_parse_int(self) }
    def parse_float() -> Option[float] { return __kiln_str_parse_float(self) }
}

# ---- Conformance: Vec[T] ----------------------------------------------------

impl[T: Clone] Clone for Vec[T] { hook clone() -> Vec[T] {} }
impl[T: Eq] Eq for Vec[T] {}
impl[T: PartialEq] PartialEq for Vec[T] { hook ==(other: Vec[T]) -> bool {} }
impl[T: Hash] Hash for Vec[T] { hook hash() -> int {} }
impl[T: Ord] Ord for Vec[T] { hook <=>(other: Vec[T]) -> Ordering {} }
impl[T: PartialOrd] PartialOrd for Vec[T] { hook <(other: Vec[T]) -> bool {} }
impl[T: Debug] Debug for Vec[T] { hook debug_str() -> str {} }
impl Default for Vec[T] { @static hook default() -> Vec[T] {} }
impl[T] Addable for Vec[T] { hook +(rhs: Vec[T]) -> Vec[T] {} }
impl Zero for Vec[T] { @static hook zero() -> Vec[T] {} }
impl Semigroup for Vec[T] {}
impl Monoid for Vec[T] {}
impl[T] Iterable for Vec[T] {
    hook iter() -> VecIter[T] {
        return VecIter { vec: self, index: 0 }
    }
}
impl[T] Iterator for VecIter[T] {
    hook next() -> Option[T] {
        if self.index >= self.vec.len() {
            return Option:None
        }
        val: T = self.vec.get(self.index)
        self.index = self.index + 1
        return Option:Some { value: val }
    }
}
impl Foldable for Vec[T] {}
impl[T] IndexableWith[int] for Vec[T] { hook [](index: int) -> T {} }
impl Indexable for Vec[T] {}

