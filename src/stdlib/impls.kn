    def fmin(other: float) -> float { return __kiln_math_fmin(float(self), other) }
    def fmax(other: float) -> float { return __kiln_math_fmax(float(self), other) }
    def fclamp(lo: float, hi: float) -> float { return __kiln_math_fclamp(float(self), lo, hi) }
    def is_nan() -> bool { return false }
    def is_infinite() -> bool { return false }
    def is_finite() -> bool { return true }
    def isclose(other: float, rel_tol: float, abs_tol: float) -> bool {
        return __kiln_math_isclose(float(self), other, rel_tol, abs_tol)
    }
}

