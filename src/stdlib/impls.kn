    def is_nan() -> bool { return __kiln_math_is_nan(self) }
    def is_infinite() -> bool { return __kiln_math_is_infinite(self) }
    def is_finite() -> bool { return __kiln_math_is_finite(self) }
    def isclose(other: float, rel_tol: float, abs_tol: float) -> bool {
        return __kiln_math_isclose(self, other, rel_tol, abs_tol)
    }
}

