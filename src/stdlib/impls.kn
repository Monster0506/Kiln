    def atan() -> float { return __kiln_math_atan(float(self)) }
    def atan2(x: float) -> float { return __kiln_math_atan2(float(self), x) }
    def sinh() -> float { return __kiln_math_sinh(float(self)) }
    def cosh() -> float { return __kiln_math_cosh(float(self)) }
    def tanh() -> float { return __kiln_math_tanh(float(self)) }
    def asinh() -> float { return __kiln_math_asinh(float(self)) }
    def acosh() -> float { return __kiln_math_acosh(float(self)) }
