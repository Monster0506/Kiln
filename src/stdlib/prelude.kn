impl Clone for float { hook clone() -> float {} }
impl PartialEq for float { hook ==(other: float) -> bool {} }
impl PartialOrd for float { hook <(other: float) -> bool {} }
impl Debug for float { hook debug_str() -> str {} }
impl Default for float { @static hook default() -> float {} }
impl AddableWith[float] for float { hook +(rhs: float) -> float {} }
impl SubtractableWith[float] for float { hook -(rhs: float) -> float {} }
impl MultipliableWith[float] for float { hook *(rhs: float) -> float {} }
impl DividableWith[float] for float { hook /(rhs: float) -> float {} }
impl Addable for float { hook +(rhs: float) -> float {} }
impl Subtractable for float { hook -(rhs: float) -> float {} }
impl Multiplicable for float { hook *(rhs: float) -> float {} }
impl Divisible for float { hook /(rhs: float) -> float {} }
impl Negatable for float { hook -() -> float {} }
impl Zero for float { @static hook zero() -> float {} }
impl One for float { @static hook one() -> float {} }
impl Abs for float { hook abs() -> float {} }
impl Signum for float { hook signum() -> float {} }
impl ComparableWith[float] for float { hook <=>(other: float) -> Ordering {} }
impl Comparable for float {}
impl Numeric for float {}
impl Fractional for float {}
impl Semigroup for float {}

# ---- Conformance: bool ------------------------------------------------------

impl Copy for bool {}
impl Clone for bool { hook clone() -> bool {} }
impl Eq for bool {}
impl PartialEq for bool { hook ==(other: bool) -> bool {} }
impl Hash for bool { hook hash() -> int {} }
impl Ord for bool { hook <=>(other: bool) -> Ordering {} }
impl PartialOrd for bool { hook <(other: bool) -> bool {} }
impl Debug for bool { hook debug_str() -> str {} }
impl Default for bool { @static hook default() -> bool {} }

# ---- Conformance: str -------------------------------------------------------

impl Clone for str { hook clone() -> str {} }
impl Eq for str {}
impl PartialEq for str { hook ==(other: str) -> bool {} }
impl Hash for str { hook hash() -> int {} }
impl Ord for str { hook <=>(other: str) -> Ordering {} }
impl PartialOrd for str { hook <(other: str) -> bool {} }
impl Debug for str { hook debug_str() -> str {} }
impl Default for str { @static hook default() -> str { return '' } }
impl AddableWith[str] for str { hook +(rhs: str) -> str { return __kiln_str_concat(self, rhs) } }
impl Addable for str { hook +(rhs: str) -> str { return __kiln_str_concat(self, rhs) } }
impl Zero for str { @static hook zero() -> str { return '' } }
impl Semigroup for str {}
impl Monoid for str {}
impl IndexableWith[int] for str { hook [](index: int) -> str {} }
impl Indexable for str {}

# ---- Conformance: Vec[T] ----------------------------------------------------

impl[T: Clone] Clone for Vec[T] { hook clone() -> Vec[T] {} }
impl[T: Eq] Eq for Vec[T] {}
impl[T: PartialEq] PartialEq for Vec[T] { hook ==(other: Vec[T]) -> bool {} }
impl[T: Hash] Hash for Vec[T] { hook hash() -> int {} }
impl[T: Ord] Ord for Vec[T] { hook <=>(other: Vec[T]) -> Ordering {} }
impl[T: PartialOrd] PartialOrd for Vec[T] { hook <(other: Vec[T]) -> bool {} }
impl[T: Debug] Debug for Vec[T] { hook debug_str() -> str {} }
impl Default for Vec[T] { @static hook default() -> Vec[T] {} }
impl[T] Addable for Vec[T] { hook +(rhs: Vec[T]) -> Vec[T] {} }
impl Zero for Vec[T] { @static hook zero() -> Vec[T] {} }
impl Semigroup for Vec[T] {}
impl Monoid for Vec[T] {}
impl Iterable for Vec[T] {}
impl Foldable for Vec[T] {}
impl[T] IndexableWith[int] for Vec[T] { hook [](index: int) -> T {} }
impl Indexable for Vec[T] {}

# ---- Conformance: Option[T] -------------------------------------------------

impl[T: Clone] Clone for Option[T] { hook clone() -> Option[T] {} }
impl[T: Eq] Eq for Option[T] {}
impl[T: PartialEq] PartialEq for Option[T] { hook ==(other: Option[T]) -> bool {} }
impl[T: Hash] Hash for Option[T] { hook hash() -> int {} }
impl[T: Ord] Ord for Option[T] { hook <=>(other: Option[T]) -> Ordering {} }
impl[T: PartialOrd] PartialOrd for Option[T] { hook <(other: Option[T]) -> bool {} }
impl[T: Debug] Debug for Option[T] { hook debug_str() -> str {} }
impl[T: Display] Display for Option[T] { hook to_str() -> str {} }
impl Default for Option[T] { @static hook default() -> Option[T] {} }
impl Iterable for Option[T] {}
impl Foldable for Option[T] {}

# ---- Conformance: Display ---------------------------------------------------

impl Display for int {
    hook to_str() -> str {
        return __kiln_int_to_str(self)
    }
}

impl Display for float {
    hook to_str() -> str {
        return __kiln_float_to_str(self)
    }
}

impl Display for bool {
    hook to_str() -> str {
        return __kiln_bool_to_str(self)
    }
}

impl Display for str {
    hook to_str() -> str {
        return self
    }
}

impl[T: Display] Display for Vec[T] {
    hook to_str() -> str {
        mut res: str = "["
        mut i: int = 0
        n: int = self.len()
        while i < n {
            item: T = self.get(i)
            if i > 0 { res = res + ", " }
            res = res + item.to_str()
            i = i + 1
        }
        return res + "]"
    }
}

# ---- Standard functions -----------------------------------------------------

def print[T: Display](item: T) -> void {
    __kiln_print(item.to_str())
}

def println[T: Display](item: T) -> void {
    __kiln_println(item.to_str())
}

# ---- Vec utility methods ----------------------------------------------------

impl VecMethods for Vec[T] {
    def pop() -> void {
        self.remove(self.len() - 1)
    }

    def is_empty() -> bool {
        return self.len() == 0
    }
}

# ---- Range utilities --------------------------------------------------------

def range(start: int, stop: int) -> Vec[int] {
    mut result: Vec[int] = Vec.new()
    mut i: int = start
    while i < stop {
        result.add(i)
        i = i + 1
    }
    return result
}

def range(start: float, stop: float, step: float) -> Vec[float] {
    mut result: Vec[float] = Vec.new()
    mut i: float = start
    while i < stop {
        result.add(i)
        i = i + step
    }
    return result
}
