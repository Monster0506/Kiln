# Kiln standard library prelude.
# Types marked @builtin have compiler-internal implementations; the declarations
# here are the source of truth for their interfaces and source locations.

# ---- Builtin struct declarations --------------------------------------------

@builtin
struct Vec[T] {
    def new() -> Vec[T]
    def add(item: T) -> void
    def len() -> int
    def get(index: int) -> T
    def set(index: int, item: T) -> void
    def remove(index: int) -> T
    def clear() -> void
}

# ---- Builtin function declarations ------------------------------------------

@builtin
def __kiln_print(s: str) -> void

@builtin
def __kiln_println(s: str) -> void

@builtin
def __kiln_int_to_str(n: int) -> str

@builtin
def __kiln_float_to_str(f: float) -> str

@builtin
def __kiln_bool_to_str(b: bool) -> str

@builtin
def __kiln_str_concat(a: str, b: str) -> str

# ---- Core marker and identity interfaces ------------------------------------

interface Copy {}

interface Clone {
    hook clone() -> Self
}

interface Eq {}

interface PartialEq {
    hook ==(other: Self) -> bool
}

interface Hash {
    hook hash() -> int
}

interface Ord {
    hook <=>(other: Self) -> Ordering
}

interface PartialOrd {
    hook <(other: Self) -> bool
}

interface Debug {
    hook debug_str() -> str
}

interface Display {
    hook to_str() -> str
}

interface Default {
    @static
    hook default() -> Self
}

interface Constructable {
    @static
    hook new() -> Self
}

interface Empty {
    @static
    hook empty() -> Self
}

interface Invertible {
    hook !() -> Self
}

interface Normalizeable {
    hook +() -> Self
}

# ---- Arithmetic layer 1: heterogeneous typed relations ----------------------

interface AddableWith[Rhs] {
    type Output
    hook +(rhs: Rhs) -> Output
}

interface SubtractableWith[Rhs] {
    type Output
    hook -(rhs: Rhs) -> Output
}

interface MultipliableWith[Rhs] {
    type Output
    hook *(rhs: Rhs) -> Output
}

interface DividableWith[Rhs] {
    type Output
    hook /(rhs: Rhs) -> Output
}

interface RemainderableWith[Rhs] {
    type Output
    hook %(rhs: Rhs) -> Output
}

interface EquatableWith[Rhs] {
    hook ==(rhs: Rhs) -> bool
}

interface ComparableWith[Rhs] {
    hook <=>(rhs: Rhs) -> Ordering
}

# ---- Assign operation interfaces --------------------------------------------

interface AddAssignableWith[Rhs] {
    hook +=(rhs: Rhs) -> void
}

interface SubtractAssignableWith[Rhs] {
    hook -=(rhs: Rhs) -> void
}

interface MultiplyAssignableWith[Rhs] {
    hook *=(rhs: Rhs) -> void
}

interface DivideAssignableWith[Rhs] {
    hook /=(rhs: Rhs) -> void
}

interface RemainderAssignableWith[Rhs] {
    hook %=(rhs: Rhs) -> void
}

# ---- Indexing interfaces ----------------------------------------------------

interface IndexableWith[Index] {
    type Output
    hook [](index: Index) -> Output
}

interface MutableIndexableWith[Index] {
    type Output
    hook []=(index: Index, value: Output) -> void
}

# ---- Assign operation closed shorthands ------------------------------------

interface AddAssignable: AddAssignableWith[Self] {
    hook +=(rhs: Self) -> void
}

interface SubtractAssignable: SubtractAssignableWith[Self] {
    hook -=(rhs: Self) -> void
}

interface MultiplyAssignable: MultiplyAssignableWith[Self] {
    hook *=(rhs: Self) -> void
}

interface DivideAssignable: DivideAssignableWith[Self] {
    hook /=(rhs: Self) -> void
}

interface RemainderAssignable: RemainderAssignableWith[Self] {
    hook %=(rhs: Self) -> void
}

# ---- Arithmetic layer 2: closed self-typed shorthands -----------------------

interface Addable: AddableWith[Self, Output=Self] {
    hook +(rhs: Self) -> Self
}

interface Subtractable: SubtractableWith[Self, Output=Self] {
    hook -(rhs: Self) -> Self
}

interface Multiplicable: MultipliableWith[Self, Output=Self] {
    hook *(rhs: Self) -> Self
}

interface Divisible: DividableWith[Self, Output=Self] {
    hook /(rhs: Self) -> Self
}

interface Remainder: RemainderableWith[Self, Output=Self] {
    hook %(rhs: Self) -> Self
}

interface Negatable {
    hook -() -> Self
}

interface Comparable: ComparableWith[Self] {}

# ---- Numeric property interfaces --------------------------------------------

interface Zero {
    @static
    hook zero() -> Self
}

interface One {
    @static
    hook one() -> Self
}

interface Abs {
    hook abs() -> Self
}

interface Signum {
    hook signum() -> Self
}

interface Bitwise {
    hook &(rhs: Self) -> Self
    hook |(rhs: Self) -> Self
    hook ^(rhs: Self) -> Self
}

# ---- Algebraic structures ---------------------------------------------------

interface Semigroup:
    Addable {}

interface Monoid:
    Semigroup,
    Zero {}

interface Group:
    Monoid,
    Negatable {}

interface Ring:
    Group,
    Multiplicable,
    One {}

interface Field:
    Ring,
    Divisible {}

# ---- Numeric hierarchy ------------------------------------------------------

interface Numeric:
    Field,
    Comparable {}

interface Integral:
    Numeric,
    Remainder {}

interface Fractional:
    Numeric {}

# ---- Callable, iterator, and iteration hierarchy ----------------------------

interface Callable[Args, Ret] {
    hook ()(args: Args) -> Ret
}

interface Iterator {
    type Item: Copy
    hook next() -> Option[Item]
}

interface Iterable {
    type Item
    type Iter: Iterator
    hook iter() -> Iter {}
}

interface Foldable {}

# ---- Collection semantics ---------------------------------------------------

interface Collection: Iterable {}

interface Sequence:
    Collection,
    Indexable {}

# ---- Functional abstractions ------------------------------------------------

interface Predicate[T]: Callable[(T), bool] {}

interface Mapper[T, U]: Callable[(T), U] {}

# ---- Conversion -------------------------------------------------------------

interface Into[T] {
    hook into() -> T
}

interface From[T] {
    hook from(value: T) -> Self
}

# ---- Indexable: integer-indexed shorthand -----------------------------------

interface Indexable: IndexableWith[int] {}

# ---- VecMethods interface ---------------------------------------------------

interface VecMethods {
    def pop() -> void {}
    def is_empty() -> bool {}
}

# ---- Conformance: int -------------------------------------------------------

impl Copy for int {}
impl Clone for int { hook clone() -> int {} }
impl Eq for int {}
impl PartialEq for int { hook ==(other: int) -> bool {} }
impl Hash for int { hook hash() -> int {} }
impl Ord for int { hook <=>(other: int) -> Ordering {} }
impl PartialOrd for int { hook <(other: int) -> bool {} }
impl Debug for int { hook debug_str() -> str {} }
impl Default for int { @static hook default() -> int {} }
impl AddableWith[int] for int { hook +(rhs: int) -> int {} }
impl SubtractableWith[int] for int { hook -(rhs: int) -> int {} }
impl MultipliableWith[int] for int { hook *(rhs: int) -> int {} }
impl DividableWith[int] for int { hook /(rhs: int) -> int {} }
impl RemainderableWith[int] for int { hook %(rhs: int) -> int {} }
impl Addable for int { hook +(rhs: int) -> int {} }
impl Subtractable for int { hook -(rhs: int) -> int {} }
impl Multiplicable for int { hook *(rhs: int) -> int {} }
impl Divisible for int { hook /(rhs: int) -> int {} }
impl Remainder for int { hook %(rhs: int) -> int {} }
impl Negatable for int { hook -() -> int {} }
impl Zero for int { @static hook zero() -> int {} }
impl One for int { @static hook one() -> int {} }
impl Abs for int { hook abs() -> int {} }
impl Signum for int { hook signum() -> int {} }
impl Bitwise for int {
    hook &(rhs: int) -> int {}
    hook |(rhs: int) -> int {}
    hook ^(rhs: int) -> int {}
}
impl Comparable for int {}
impl Numeric for int {}
impl Integral for int {}
impl Semigroup for int {}
impl Monoid for int {}

